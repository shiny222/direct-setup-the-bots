FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 bridge && useradd --uid 10001 --gid bridge bridge
WORKDIR /app
ARG BOT_ENTRY
COPY --from=source ${BOT_ENTRY} /app/${BOT_ENTRY}
RUN --mount=from=source,target=/source \
    if [ -f /source/requirements.txt ]; then cd /source && pip install --no-cache-dir -r requirements.txt; \
    else pip install --no-cache-dir python-telegram-bot==21.6 requests httpx; fi
ENV BOT_ENTRY=${BOT_ENTRY} PYTHONUNBUFFERED=1
COPY --chmod=755 start-bot.sh /usr/local/bin/start-bot
ENTRYPOINT ["start-bot"]
